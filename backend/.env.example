# --- Supabase Storage (S3) — fichiers persistants sur Render ---
# 1. Crée un bucket dans Supabase → Storage (privé recommandé)
# 2. Settings → Storage → S3 → Access Key / Secret / Endpoint / Region
# USE_S3_MEDIA=True
# SUPABASE_BUCKET_PUBLIC=False
# SUPABASE_PROJECT_REF=eyjhscpbdimuqetkwway
# AWS_STORAGE_BUCKET_NAME=course-videos-pdfs
# AWS_S3_ENDPOINT_URL=https://eyjhscpbdimuqetkwway.storage.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=eu-west-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_QUERYSTRING_EXPIRE=3600
# (MEDIA_URL optionnel — défaut selon public/privé)

# --- PythonAnywhere (alternative, SQLite) ---
# DEBUG=False
# ALLOWED_HOSTS=<username>.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://<username>.pythonanywhere.com
# Ne pas définir DATABASE_URL → SQLite (db.sqlite3)

# --- PawaPay (Mobile Money, RD Congo) ---
# Token UNIQUEMENT côté serveur. Ne jamais le mettre dans Flutter / git.
# Pour la prod : copier aussi dans backend/.env.render puis Render → Environment.
# PAWAPAY_API_TOKEN=your-pawapay-bearer-token
# Token sandbox → https://api.sandbox.pawapay.io
# Token live     → https://api.pawapay.io
# PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# PAWAPAY_CURRENCY=USD
# PAWAPAY_COUNTRY=COD
